diff -ruN '--exclude=*.bak*' duckdb-clean/src/optimizer/like_selectivity.cpp duckdb/src/optimizer/like_selectivity.cpp
--- duckdb-clean/src/optimizer/like_selectivity.cpp	1970-01-01 01:00:00.000000000 +0100
+++ duckdb/src/optimizer/like_selectivity.cpp	2026-10-20 11:09:01.847116167 +0200
@@ -0,0 +1,281 @@
+#include "duckdb/optimizer/like_selectivity.hpp"
+
+#include "duckdb/planner/expression/bound_comparison_expression.hpp"
+#include "duckdb/planner/expression/bound_conjunction_expression.hpp"
+#include "duckdb/planner/expression/bound_constant_expression.hpp"
+#include "duckdb/planner/expression/bound_function_expression.hpp"
+#include "duckdb/planner/expression/bound_operator_expression.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+
+namespace duckdb {
+
+LikeSelectivity &LikeSelectivity::Get() {
+	static LikeSelectivity instance;
+	return instance;
+}
+
+LikeSelectivity::LikeSelectivity() {
+	Load();
+}
+
+string LikeSelectivity::GetFilePath() const {
+	const char *env_path = std::getenv("DUCKDB_LIKE_SELECTIVITY_FILE");
+	if (env_path && *env_path) {
+		return string(env_path);
+	}
+	return "like_selectivity.txt";
+}
+
+void LikeSelectivity::Load() {
+	std::ifstream file(GetFilePath());
+	if (!file.good()) {
+		// Optional file: absence just means every pattern uses the default.
+		return;
+	}
+
+	string line;
+	while (std::getline(file, line)) {
+		if (line.empty() || line[0] == '#') {
+			continue;
+		}
+
+		// Split on the LAST tab: LIKE patterns frequently contain spaces
+		// (e.g. "% foo bar %"), so whitespace-based tokenization is unsafe.
+		auto tab_pos = line.find_last_of('\t');
+		if (tab_pos == string::npos || tab_pos == 0) {
+			// Malformed line: skip it, but keep loading the rest of the file.
+			continue;
+		}
+
+		auto pattern = line.substr(0, tab_pos);
+		auto value_str = line.substr(tab_pos + 1);
+
+		double value;
+		try {
+			size_t chars_consumed;
+			value = std::stod(value_str, &chars_consumed);
+			if (chars_consumed != value_str.size()) {
+				continue;
+			}
+		} catch (...) {
+			continue;
+		}
+
+		// Selectivities are probabilities: clamp defensively.
+		if (value < 0.0) {
+			value = 0.0;
+		} else if (value > 1.0) {
+			value = 1.0;
+		}
+
+		estimates[pattern] = value;
+	}
+}
+
+double LikeSelectivity::Lookup(const string &pattern) const {
+	auto entry = estimates.find(pattern);
+	if (entry != estimates.end()) {
+		return entry->second;
+	}
+	return DEFAULT_LIKE_SELECTIVITY;
+}
+
+bool LikeSelectivity::TryLookup(const string &pattern, double &selectivity_out) const {
+	auto entry = estimates.find(pattern);
+	if (entry == estimates.end()) {
+		return false;
+	}
+	selectivity_out = entry->second;
+	return true;
+}
+
+//! Optional trace: export DUCKDB_LIKE_DEBUG=1
+static bool LikeDebug() {
+	static const bool on = std::getenv("DUCKDB_LIKE_DEBUG") != nullptr;
+	return on;
+}
+
+//! Checks whether `upper` is the FilterCombiner's standard range-encoding
+//! of a prefix pattern whose lower bound is `lower` - i.e. `upper` equals
+//! `lower` with trailing 0xFF bytes stripped and the final remaining byte
+//! incremented by one (the smallest string that is NOT prefixed by `lower`).
+static bool IsPrefixRangeUpperBound(const string &lower, const string &upper) {
+	if (lower.empty()) {
+		return false;
+	}
+	size_t end = lower.size();
+	while (end > 0 && static_cast<unsigned char>(lower[end - 1]) == 0xFF) {
+		end--;
+	}
+	if (end == 0) {
+		return false;
+	}
+	string expected = lower.substr(0, end - 1);
+	expected += static_cast<char>(static_cast<unsigned char>(lower[end - 1]) + 1);
+	return upper == expected;
+}
+
+//! (col >= 'p') AND (col < 'p+1')  ->  pattern "p%"
+template <class CHILDREN>
+static bool TryPrefixRange(const CHILDREN &children, string &pattern_out) {
+	if (children.size() != 2) {
+		return false;
+	}
+	string lower_bound, upper_bound;
+	bool has_lower = false, has_upper = false;
+	for (auto &child : children) {
+		if (child->GetExpressionClass() != ExpressionClass::BOUND_FUNCTION ||
+		    !BoundComparisonExpression::IsComparison(*child)) {
+			return false;
+		}
+		auto &func_expr = child->template Cast<BoundFunctionExpression>();
+		const Expression &right_expr = BoundComparisonExpression::Right(func_expr);
+		if (right_expr.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+			return false;
+		}
+		auto &val = right_expr.Cast<BoundConstantExpression>().GetValue();
+		if (val.IsNull() || val.type().id() != LogicalTypeId::VARCHAR) {
+			return false;
+		}
+		auto cmp_type = child->GetExpressionType();
+		if (cmp_type == ExpressionType::COMPARE_GREATERTHANOREQUALTO) {
+			lower_bound = StringValue::Get(val);
+			has_lower = true;
+		} else if (cmp_type == ExpressionType::COMPARE_LESSTHAN) {
+			upper_bound = StringValue::Get(val);
+			has_upper = true;
+		} else {
+			return false;
+		}
+	}
+	if (has_lower && has_upper && IsPrefixRangeUpperBound(lower_bound, upper_bound)) {
+		pattern_out = lower_bound + "%";
+		return true;
+	}
+	return false;
+}
+
+//! One LIKE-shaped function: ~~, !~~, contains, prefix, suffix, >=
+//!
+//! DuckDB's LikeOptimizationRule transforms LIKE patterns:
+//!   '%word%' -> contains(col, 'word')
+//!   'word%'  -> prefix(col, 'word')
+//!   '%word'  -> suffix(col, 'word')
+//!   others   -> stay as ~~
+//! FilterCombiner may further turn 'word%' into col >= 'word' AND col < '...'.
+//! We reconstruct the original pattern for an exact lookup in the file.
+//! GLOB variants ("~~~", "!~~~") and ILIKE are intentionally unhandled.
+static bool TryGetFunctionSelectivity(const BoundFunctionExpression &func, double &selectivity_out) {
+	auto &children = func.GetChildren();
+	if (children.size() != 2 || children[1]->GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+		// non-constant pattern: nothing to look up
+		return false;
+	}
+	auto &pattern_value = children[1]->Cast<BoundConstantExpression>().GetValue();
+	if (pattern_value.IsNull() || pattern_value.type().id() != LogicalTypeId::VARCHAR) {
+		return false;
+	}
+	auto &raw = StringValue::Get(pattern_value);
+	auto &name = func.Function().GetName();
+
+	string pattern;
+	bool negate = false;
+	if (name == "~~") {
+		pattern = raw;
+	} else if (name == "!~~") {
+		// NOT LIKE: look up the positive pattern, then negate.
+		pattern = raw;
+		negate = true;
+	} else if (name == "contains") {
+		pattern = "%" + raw + "%";
+	} else if (name == "prefix" || name == ">=") {
+		pattern = raw + "%";
+	} else if (name == "suffix") {
+		pattern = "%" + raw;
+	} else {
+		return false;
+	}
+
+	double s;
+	bool hit = LikeSelectivity::Get().TryLookup(pattern, s);
+	if (LikeDebug()) {
+		fprintf(stderr, "[LIKESEL] fn=%s key='%s' hit=%d\n", name.c_str(), pattern.c_str(), (int)hit);
+	}
+	if (!hit) {
+		return false;
+	}
+	selectivity_out = negate ? 1.0 - s : s;
+	return true;
+}
+
+bool LikeSelectivity::TryGetLikeSelectivity(const Expression &expr, double &selectivity_out) {
+	switch (expr.GetExpressionClass()) {
+	case ExpressionClass::BOUND_CONJUNCTION: {
+		auto &conj = expr.Cast<BoundConjunctionExpression>();
+		auto &children = conj.GetChildren();
+
+		if (conj.GetExpressionType() == ExpressionType::CONJUNCTION_AND) {
+			// 1) the FilterCombiner's prefix range
+			string pattern;
+			if (TryPrefixRange(children, pattern)) {
+				bool hit = LikeSelectivity::Get().TryLookup(pattern, selectivity_out);
+				if (LikeDebug()) {
+					fprintf(stderr, "[LIKESEL] range key='%s' hit=%d\n", pattern.c_str(), (int)hit);
+				}
+				return hit;
+			}
+			// 2) general AND: multiply every child we can resolve (independence assumption).
+			//    Unresolvable children are skipped, i.e. they contribute selectivity 1.
+			double combined = 1.0;
+			bool found = false;
+			for (auto &child : children) {
+				double s;
+				if (TryGetLikeSelectivity(*child, s)) {
+					combined *= s;
+					found = true;
+				}
+			}
+			if (found) {
+				selectivity_out = combined;
+			}
+			return found;
+		}
+
+		if (conj.GetExpressionType() == ExpressionType::CONJUNCTION_OR) {
+			// OR needs ALL children resolved; otherwise the union is unknowable.
+			double miss = 1.0;
+			for (auto &child : children) {
+				double s;
+				if (!TryGetLikeSelectivity(*child, s)) {
+					return false;
+				}
+				miss *= (1.0 - s);
+			}
+			selectivity_out = 1.0 - miss;
+			return true;
+		}
+		return false;
+	}
+	case ExpressionClass::BOUND_OPERATOR: {
+		// NOT contains(col, 'word') etc: recurse and negate.
+		if (expr.GetExpressionType() != ExpressionType::OPERATOR_NOT) {
+			return false;
+		}
+		auto &children = expr.Cast<BoundOperatorExpression>().GetChildren();
+		double s;
+		if (children.size() == 1 && TryGetLikeSelectivity(*children[0], s)) {
+			selectivity_out = 1.0 - s;
+			return true;
+		}
+		return false;
+	}
+	case ExpressionClass::BOUND_FUNCTION:
+		return TryGetFunctionSelectivity(expr.Cast<BoundFunctionExpression>(), selectivity_out);
+	default:
+		return false;
+	}
+}
+
+} // namespace duckdb
